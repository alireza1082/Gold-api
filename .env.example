# Optional gold-provider fallback credential
ONE_API_TOKEN=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Outbound HTTP timeout in seconds
REQUEST_TIMEOUT_SECONDS=10

# Cache refresh and stale-data windows
GOLD_CACHE_TTL_SECONDS=900
USD_CACHE_TTL_SECONDS=1800
MAX_STALE_SECONDS=10800
REFRESH_LOCK_SECONDS=30

# Dynamic endpoint strings (reloaded automatically on change without restart)
HOKM_STRING=Tapsell
XO_STRING=Adivery
